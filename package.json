{
  "name": "proofer",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@github.com:campersground-kr/proofer.git"
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "build": "npx prisma generate && next build",
    "deploy": "npm run build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint && npm run lint:stylelint",
    "lint:stylelint": "stylelint '**/*.css' --cache",
    "jest": "jest --passWithNoTests",
    "jest:watch": "jest --watch",
    "prettier:check": "prettier --check \"**/*.{ts,tsx}\"",
    "prettier:write": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "npm run prettier:check && npm run lint && npm run typecheck && npm run jest",
    "semantic-release": "semantic-release --no-ci --dry-run false",
    "prepare": "husky install"
  },
  "dependencies": {
    "@mantine/carousel": "^7.5.3",
    "@mantine/charts": "^7.5.3",
    "@mantine/code-highlight": "^7.5.3",
    "@mantine/core": "^7.5.3",
    "@mantine/dates": "^7.5.3",
    "@mantine/dropzone": "^7.5.3",
    "@mantine/form": "^7.5.3",
    "@mantine/hooks": "^7.5.3",
    "@mantine/modals": "^7.5.3",
    "@mantine/notifications": "^7.5.3",
    "@mantine/nprogress": "^7.5.3",
    "@mantine/spotlight": "^7.5.3",
    "@mantine/tiptap": "^7.5.3",
    "@next/bundle-analyzer": "^14.1.0",
    "@next/third-parties": "^14.1.0",
    "@prisma/adapter-pg": "^5.10.2",
    "@prisma/client": "^5.10.2",
    "@react-pdf-viewer/core": "^3.12.0",
    "@react-pdf-viewer/get-file": "^3.12.0",
    "@tabler/icons-react": "^2.47.0",
    "@tiptap/extension-link": "^2.2.4",
    "@tiptap/react": "^2.2.4",
    "@tiptap/starter-kit": "^2.2.4",
    "@vercel/analytics": "^1.2.2",
    "@vercel/blob": "^0.22.1",
    "@vercel/kv": "^1.0.1",
    "@vercel/postgres": "^0.7.2",
    "@vercel/speed-insights": "^1.0.10",
    "dayjs": "^1.11.10",
    "embla-carousel-react": "^8.0.0",
    "eslint-config-next": "^14.1.0",
    "mobile-detect": "^1.4.5",
    "next": "14.1.0",
    "pg": "^8.11.3",
    "react": "18.2.0",
    "react-device-detect": "^2.2.3",
    "react-dom": "18.2.0",
    "recharts": "^2.12.1",
    "swr": "^2.2.5"
  },
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@next/eslint-plugin-next": "^14.1.0",
    "@semantic-release/git": "^10.0.1",
    "@testing-library/dom": "^9.3.4",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.20",
    "@types/react": "18.2.58",
    "babel-loader": "^9.1.3",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-mantine": "3.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^27.9.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-testing-library": "^6.2.0",
    "got": ">=14.2.0",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.35",
    "postcss-preset-mantine": "1.13.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.2.5",
    "prisma": "^5.10.2",
    "sass": "^1.71.1",
    "semantic-release": "^23.0.2",
    "stylelint": "^16.2.1",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-config-standard-scss": "^13.0.0",
    "tough-cookie": ">=4.1.3",
    "ts-jest": "^29.1.2",
    "typescript": "5.3.3"
  }
}
