{
  "name": "proofer",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "repository": {
    "type": "git",
    "url": "git@github.com:proofer-tech/proofer.git"
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "build": "unset __NEXT_PRIVATE_STANDALONE_CONFIG; next build",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate:pg --config drizzle.config.ts",
    "db:migrate": "tsx database/scripts/migrate.js",
    "db:drop": "drizzle-kit drop --config drizzle.config.ts",
    "deploy": "npm run build",
    "analyze": "unset __NEXT_PRIVATE_STANDALONE_CONFIG; ANALYZE=true next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "generate-pwa": "pwa-assets-generator --preset minimal-2023 public/ic_launcher.svg",
    "lint": "eslint . && npm run lint:stylelint",
    "lint:stylelint": "stylelint 'app/**/*.{css,scss}' 'src/**/*.{css,scss}' 'components/**/*.{css,scss}' --cache",
    "jest": "jest --passWithNoTests",
    "jest:watch": "jest --watch",
    "prettier:check": "prettier --check \"**/*.{ts,tsx}\"",
    "prettier:write": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "npm run prettier:check && npm run lint && npm run typecheck && npm run jest",
    "semantic-release": "semantic-release --no-ci --dry-run false",
    "prepare": "husky install"
  },
