{
  "name": "proofer",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@github.com:proofer-tech/proofer.git"
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate:pg --config drizzle.config.ts",
    "db:migrate": "tsx database/scripts/migrate.js",
    "db:drop": "drizzle-kit drop --config drizzle.config.ts",
    "deploy": "npm run build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "generate-pwa": "pwa-assets-generator --preset minimal-2023 public/ic_launcher.svg",
    "lint": "next lint && npm run lint:stylelint",
    "lint:stylelint": "stylelint '**/*.css' --cache",
    "jest": "jest --passWithNoTests",
    "jest:watch": "jest --watch",
    "prettier:check": "prettier --check \"**/*.{ts,tsx}\"",
    "prettier:write": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "npm run prettier:check && npm run lint && npm run typecheck && npm run jest",
    "semantic-release": "semantic-release --no-ci --dry-run false",
    "prepare": "husky install"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^3.5.0",
    "@mantine/carousel": "^7.10.2",
    "@mantine/charts": "^7.10.2",
    "@mantine/code-highlight": "^7.10.2",
    "@mantine/core": "^7.10.2",
    "@mantine/dates": "^7.10.2",
    "@mantine/dropzone": "^7.10.2",
    "@mantine/form": "^7.10.2",
    "@mantine/hooks": "^7.10.2",
    "@mantine/modals": "^7.10.2",
    "@mantine/notifications": "^7.10.2",
    "@mantine/nprogress": "^7.10.2",
    "@mantine/spotlight": "^7.10.2",
    "@mantine/tiptap": "^7.10.2",
    "@next/bundle-analyzer": "^14.1.0",
    "@next/third-parties": "^14.1.0",
    "@react-pdf-viewer/core": "^3.12.0",
    "@react-pdf-viewer/get-file": "^3.12.0",
    "@react-pdf/renderer": "^3.4.4",
    "@sentry/nextjs": "^8.33.1",
    "@tabler/icons-react": "^2.47.0",
    "@tiptap/extension-link": "^2.2.4",
    "@tiptap/react": "^2.2.4",
    "@tiptap/starter-kit": "^2.2.4",
    "@upstash/lock": "^0.1.0",
    "@vercel/analytics": "^1.2.2",
    "@vercel/blob": "^0.22.3",
    "@vercel/edge-config": "^1.1.0",
    "@vercel/kv": "^1.0.1",
    "@vercel/postgres": "^0.9.0",
    "@vercel/speed-insights": "^1.0.10",
    "@web-std/file": "^3.0.3",
    "ably": "^2.0.1",
    "apexcharts": "^3.48.0",
    "array-from-async": "^3.0.0",
    "cheerio": "^1.0.0-rc.12",
    "dayjs": "^1.11.10",
    "drizzle-orm": "^0.30.1",
    "embla-carousel-react": "^8.0.0",
    "eslint-config-next": "^14.1.0",
    "http-errors": "^2.0.0",
    "iconv": "^3.0.1",
    "is-callable": "^1.2.7",
    "lodash": "^4.17.21",
    "mobile-detect": "^1.4.5",
    "moment": "^2.30.1",
    "moment-duration-format": "^2.3.2",
    "next": "14.2.14",
    "next-pwa": "^5.6.0",
    "next-share": "^0.27.0",
    "notion-page-to-html": "^1.2.0",
    "octokit": "^3.1.2",
    "pg": "^8.11.3",
    "react": "18.3.1",
    "react-apexcharts": "^1.4.1",
    "react-channel-plugin": "^2.2.0",
    "react-device-detect": "^2.2.3",
    "react-dom": "18.3.1",
    "reagraph": "^4.15.25",
    "recharts": "^2.12.2",
    "redis": "^4.6.13",
    "rss-parser": "^3.13.0",
    "schema-dts": "^1.1.2",
    "swiper": "^11.1.15",
    "swr": "^2.2.5"
  },
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@next/eslint-plugin-next": "^14.1.0",
    "@semantic-release/git": "^10.0.1",
    "@testing-library/dom": "^9.3.4",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/cookie": "^0.6.0",
    "@types/http-errors": "^2.0.4",
    "@types/is-callable": "^1.1.2",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.14.202",
    "@types/node": "^20.11.20",
    "@types/react": "18.2.58",
    "@types/redis": "^4.0.11",
    "@vite-pwa/assets-generator": "^0.2.4",
    "autoprefixer": "^10.4.20",
    "babel-loader": "^9.1.3",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.20.14",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-mantine": "3.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^27.9.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-testing-library": "^6.2.0",
    "got": ">=14.2.0",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^16.2.4",
    "pgtools": "^1.0.1",
    "postcss": "^8.4.47",
    "postcss-preset-mantine": "1.13.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.2.5",
    "sass": "^1.71.1",
    "semantic-release": "^23.0.2",
    "stylelint": "^16.2.1",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-config-standard-scss": "^13.0.0",
    "tailwindcss": "^3.4.13",
    "tough-cookie": ">=4.1.3",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "lint-staged": "^15.2.0"
  },
  "type": "module",
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,scss}": [
      "prettier --write",
      "stylelint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
